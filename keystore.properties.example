# ---------------------------------------------------------------------------
# Copy this file to `keystore.properties` (it is git-ignored) and fill it in.
# Without a keystore the release APK is UNSIGNED and Android refuses to
# install it ("App not installed" / "failed install").
#
# Create a keystore once and keep it safe - the SAME key must be used for
# every future update of the app:
#
#   keytool -genkeypair -v \
#     -keystore sensitive-pro.p12 \
#     -storetype PKCS12 \
#     -keyalg RSA -keysize 2048 -validity 10950 \
#     -alias sensitive-pro \
#     -storepass YOUR_STORE_PASSWORD \
#     -dname "CN=Sensitive Pro, OU=Mobile, O=Sensitive Pro, L=Phnom Penh, C=KH"
#
# For GitHub Actions: set the secret RELEASE_KEYSTORE_BASE64 to
#   base64 -w 0 sensitive-pro.p12
# plus RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD.
# ---------------------------------------------------------------------------
storeFile=sensitive-pro.p12
storeType=PKCS12
storePassword=CHANGE_ME
keyAlias=sensitive-pro
keyPassword=CHANGE_ME
