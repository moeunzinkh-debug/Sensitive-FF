<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="វិភាគទូរស័ព្ទដោយស្វ័យប្រវត្តិ"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ចុចប៊ូតុងខាងក្រោមដើម្បីស្គេនទូរស័ព្ទរបស់អ្នក"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:padding="14dp"
            android:text="🔍 ស្គេនទូរស័ព្ទឥឡូវនេះ"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Device Info Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 ព័ត៌មានទូរស័ព្ទ"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/divider" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="2"
                    android:rowCount="4"
                    android:useDefaultMargins="true">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ម៉ូដែល" android:textColor="@color/text_hint" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvModel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ក្រុមហ៊ុន" android:textColor="@color/text_hint" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvManufacturer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Android" android:textColor="@color/text_hint" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvAndroid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAM" android:textColor="@color/text_hint" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvRam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU" android:textColor="@color/text_hint" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvCpu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="អេក្រង់" android:textColor="@color/text_hint" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hz" android:textColor="@color/text_hint" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvRefresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/accent_green" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DPI" android:textColor="@color/text_hint" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvDpi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                </GridLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/divider"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="កម្រិតដំណើរការ" android:textColor="@color/text_hint" android:textSize="11sp"/>
                <TextView android:id="@+id/tvPerformance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_chip_smg" android:padding="8dp" android:text="-" android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvPerformanceExplain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:text="-" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recommendation Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRecommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 សែនស៊ីធីវដែលបានណែនាំ"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ចម្លងហើយទៅកំណត់ក្នុង Free Fire &gt; Settings &gt; Sensitivity"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/surface_dark2" android:padding="10dp" android:textAlignment="center" android:textColor="@color/text_hint" android:textSize="11sp" android:text="ទូទៅ"/>
                        <View android:layout_width="8dp" android:layout_height="0dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/surface_dark2" android:padding="10dp" android:textAlignment="center" android:textColor="@color/text_hint" android:textSize="11sp" android:text="Red Dot"/>
                        <View android:layout_width="8dp" android:layout_height="0dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/surface_dark2" android:padding="10dp" android:textAlignment="center" android:textColor="@color/text_hint" android:textSize="11sp" android:text="2x Scope"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tvGeneral" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_gradient_primary" android:padding="12dp" android:text="190" android:textAlignment="center" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                        <View android:layout_width="8dp" android:layout_height="0dp"/>
                        <TextView android:id="@+id/tvRedDot" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card" android:padding="12dp" android:text="180" android:textAlignment="center" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                        <View android:layout_width="8dp" android:layout_height="0dp"/>
                        <TextView android:id="@+id/tv2x" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card" android:padding="12dp" android:text="170" android:textAlignment="center" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/surface_dark2" android:padding="10dp" android:textAlignment="center" android:textColor="@color/text_hint" android:textSize="11sp" android:text="4x Scope"/>
                        <View android:layout_width="8dp" android:layout_height="0dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/surface_dark2" android:padding="10dp" android:textAlignment="center" android:textColor="@color/text_hint" android:textSize="11sp" android:text="Sniper"/>
                        <View android:layout_width="8dp" android:layout_height="0dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@color/surface_dark2" android:padding="10dp" android:textAlignment="center" android:textColor="@color/text_hint" android:textSize="11sp" android:text="Free Look"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tv4x" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card" android:padding="12dp" android:text="160" android:textAlignment="center" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                        <View android:layout_width="8dp" android:layout_height="0dp"/>
                        <TextView android:id="@+id/tvSniper" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card" android:padding="12dp" android:text="120" android:textAlignment="center" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                        <View android:layout_width="8dp" android:layout_height="0dp"/>
                        <TextView android:id="@+id/tvFreeLook" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_card" android:padding="12dp" android:text="140" android:textAlignment="center" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <Button android:id="@+id/btnCopy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:backgroundTint="@color/surface_dark2" android:text="📋 ចម្លងការកំណត់" android:textColor="@color/text_primary" app:cornerRadius="12dp"/>

                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="#1A1A24" app:cardCornerRadius="12dp" app:strokeColor="@color/primary" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡 គន្លឹះជាភាសាខ្មែរ" android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvTip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:text="-" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View android:layout_width="match_parent" android:layout_height="24dp"/>
    </LinearLayout>
</ScrollView>
